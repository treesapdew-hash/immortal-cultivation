## [series, background] for a partner (by family, then by id).
static func partner(partner_id: String) -> Array:
	var fam := PartnerSkills.family_of(partner_id)
	if fam != "" and PARTNERS.has(fam):
		return PARTNERS[fam]
	return PARTNERS.get(partner_id, ["", ""])
